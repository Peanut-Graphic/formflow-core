{
    "name": "peanut/formflow-core",
    "description": "Shared form-engine + API/connector core for FormFlow Pro and Lite (extracted from the duplicated isf/fffl code).",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.0 <8.6",
        "ext-openssl": "*",
        "ext-sodium": "*"
    },
    "require-dev": { "phpunit/phpunit": "^9.6" },
    "config": {
        "platform": { "php": "8.0.0" },
        "sort-packages": true
    },
    "autoload": { "classmap": ["src/"] },
    "autoload-dev": { "psr-4": { "Peanut\\FormCore\\Tests\\": "tests/" } }
}
